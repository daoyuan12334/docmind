# =============================================================================
# DocMind 环境变量模板
#   用法：cp .env.example .env  然后填真实值
#   安全：.env 已在 .gitignore 中排除，切勿提交到仓库
# =============================================================================

# ---------------------------- 模型（阿里百炼 / OpenAI 兼容）----------------------------
# 换成 OpenAI 官方：AI_BASE_URL=https://api.openai.com/v1 ，模型名改 gpt-4o / text-embedding-3-large
DASHSCOPE_API_KEY=sk-your-key-here
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode
AI_CHAT_MODEL=qwen-plus
AI_EMBEDDING_MODEL=text-embedding-v4
AI_EMBEDDING_DIM=1024
# 多模态：图片/扫描件 OCR、语音转写、视频抽帧理解
AI_VISION_MODEL=qwen3-vl-plus
AI_OMNI_MODEL=qwen3-omni-flash
# 视频抽帧用的 ffmpeg。留空则由 tool/dev.sh 自动探测（含 npm 装的 @ffmpeg-installer/ffmpeg）。
# Windows 必须写 C:/... 形式；Git Bash 的 /c/... 会被 CreateProcess 判为找不到文件。
FFMPEG_PATH=

# ---------------------------- 数据库 ----------------------------
DB_NAME=docmind
DB_USER=docmind
DB_PASSWORD=change_me_please
PG_HOST_PORT=5432

# ---------------------------- Redis ----------------------------
REDIS_PASSWORD=change_me_please
REDIS_HOST_PORT=6379

# ---------------------------- Kafka ----------------------------
KAFKA_CLUSTER_ID=docmind-cluster-0001
KAFKA_ADVERTISED_HOST=localhost
KAFKA_HOST_PORT=9092
KAFKA_EXT_PORT=9094

# ---------------------------- MinIO ----------------------------
MINIO_ACCESS_KEY=docmind
MINIO_SECRET_KEY=change_me_please
MINIO_BUCKET=docmind
MINIO_PUBLIC_HOST=localhost
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---------------------------- 后端 ----------------------------
BACKEND_PORT=8080
# 生产必须换成 32 字节以上随机串：openssl rand -base64 48
JWT_SECRET=please-generate-a-long-random-secret-at-least-32-bytes
JWT_EXPIRE_MINUTES=720
# MCP 对外暴露的端点校验密钥（留空则 MCP 端点不鉴权，仅建议内网使用）
MCP_API_KEY=
# 允许 MCP 访问的知识库 ID，多个用逗号分隔；留空 = MCP 一律拒绝（安全默认）
DOCMIND_MCP_EXPOSE_KB_IDS=
# 每用户每日 token 配额 / 每分钟请求数
DAILY_TOKEN_QUOTA=200000
RPM_LIMIT=30

# ---------------------------- 前端 & 监控 ----------------------------
FRONTEND_PORT=80
VITE_API_BASE=/api
GRAFANA_USER=admin
GRAFANA_PASSWORD=change_me_please
GRAFANA_PORT=3000
PROM_PORT=9090

# ---------------------------- 版本 ----------------------------
DOCMIND_VERSION=1.0.0
